<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="16pt"
    android:paddingTop="24pt"
    android:paddingBottom="40pt">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44pt">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="44pt"
            android:layout_height="44pt"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_close"
            android:padding="10pt"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/colorTextPrimary"
            android:textSize="17pt"
            android:textStyle="bold" />
    </FrameLayout>

    <android.widget.Space
        android:layout_width="0dp"
        android:layout_height="16pt" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="6pt"
        android:text="@string/policy_field_package"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13pt" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48pt"
        android:background="@drawable/bg_input_field">

        <EditText
            android:id="@+id/etPackage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/policy_package_hint"
            android:paddingHorizontal="16pt"
            android:singleLine="true"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextTertiary"
            android:textSize="15pt" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12pt"
        android:paddingBottom="6pt"
        android:text="@string/policy_field_mode"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13pt" />

    <RadioGroup
        android:id="@+id/rgMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44pt"
            android:text="@string/policy_mode_auto"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15pt" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48pt"
            android:paddingBottom="6pt"
            android:text="@string/policy_mode_auto_desc"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12pt" />

        <RadioButton
            android:id="@+id/rbConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44pt"
            android:text="@string/policy_mode_confirm"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15pt" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48pt"
            android:paddingBottom="6pt"
            android:text="@string/policy_mode_confirm_desc"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12pt" />

        <RadioButton
            android:id="@+id/rbBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44pt"
            android:text="@string/policy_mode_block"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15pt" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48pt"
            android:text="@string/policy_mode_block_desc"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12pt" />
    </RadioGroup>

    <android.widget.Space
        android:layout_width="0dp"
        android:layout_height="20pt" />

    <com.apk.claw.android.widget.KButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="48pt"
        android:text="@string/common_save"
        android:textSize="15pt" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="44pt"
        android:gravity="center"
        android:text="@string/common_delete"
        android:textColor="@color/colorErrorPrimary"
        android:textSize="14pt"
        android:visibility="gone" />

</LinearLayout>
