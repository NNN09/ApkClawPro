<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgSecondary"
    android:orientation="vertical">

    <!-- Toolbar -->
    <com.apk.claw.android.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56pt" />

    <!-- 滚动内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8pt"
            android:paddingBottom="24pt">

            <!-- 模型分组 -->
            <com.apk.claw.android.widget.MenuGroup
                android:id="@+id/modelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8pt" />

            <!-- 自动化分组 -->
            <com.apk.claw.android.widget.MenuGroup
                android:id="@+id/automationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 通用分组 -->
            <com.apk.claw.android.widget.MenuGroup
                android:id="@+id/generalGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 通道分组（置底） -->
            <com.apk.claw.android.widget.MenuGroup
                android:id="@+id/channelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24pt" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
