<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="android.widget.LinearLayout">

    <!-- 菜单项内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12pt"
        android:paddingStart="16pt"
        android:paddingEnd="16pt">

        <!-- 左侧图标（统一圆底容器） -->
        <ImageView
            android:id="@+id/ivLeading"
            android:layout_width="36pt"
            android:layout_height="36pt"
            android:background="@drawable/bg_icon_circle_neutral"
            android:padding="7pt"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher"
            tools:ignore="UseAppTint" />

        <!-- 标题 + 副标题 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12pt"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15pt"
                tools:text="菜单标题" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2pt"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12pt"
                android:visibility="gone"
                tools:text="副标题"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 红点 -->
        <View
            android:id="@+id/viewRedDot"
            android:layout_width="8pt"
            android:layout_height="8pt"
            android:layout_marginEnd="6pt"
            android:background="@drawable/bg_red_dot"
            android:visibility="gone" />

        <!-- 尾部状态文字 -->
        <TextView
            android:id="@+id/tvTrailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorTextTertiary"
            android:textSize="13pt"
            android:visibility="gone"
            tools:text="状态"
            tools:visibility="visible" />

        <!-- 尾部箭头图标 -->
        <ImageView
            android:id="@+id/ivTrailing"
            android:layout_width="20pt"
            android:layout_height="20pt"
            android:layout_marginStart="6pt"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/colorTextTertiary"
            tools:ignore="UseAppTint" />

    </LinearLayout>

    <!-- 分隔线（与标题左缘对齐：16pt + 36pt + 12pt） -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1pt"
        android:layout_marginStart="64pt"
        android:background="@color/colorBorderBase"
        android:visibility="visible" />

</merge>
